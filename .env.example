# DuckDuckGo MCP Server – environment configuration
# Copy this file to .env and adjust as needed.
# Docker Compose will load .env automatically via the env_file directive.

# SafeSearch mode: STRICT | MODERATE | OFF  (default: MODERATE)
DDG_SAFE_SEARCH=MODERATE

# Search region, e.g. us-en, gb-en, de-de, jp-ja, wt-wt (default: wt-wt / worldwide)
DDG_REGION=wt-wt
